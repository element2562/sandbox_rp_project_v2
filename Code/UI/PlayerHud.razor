@using Sandbox
@using Sandbox.UI
@using System
@inherits PanelComponent
@namespace Sandbox

@if (Network.IsProxy)
{
    return;
}

<root class="player-hud">
    <div class="hudItem">
        <p>❤️</p>
        <div class="health-bar">
            <div class="health-fill"
                 style="width:@(Math.Clamp((_playerHealthController.Health / 100f) * 100f, 0f, 100f))%;">
                <!-- Place the health text *inside* the fill -->
                <div class="health-text">
                    <p>@(_playerHealthController.Health > 0 ? $"{_playerHealthController.Health}%" : "")</p>
                </div>
            </div>
        </div>
    </div>
    <div class="hudItem">
        <p>💼</p>
        <div class="jobDiv">
            <div class="jobFill" style="width: 100%">
                <div class="jobText">
                    <p>@(_playerJobController.CurrentJob?.Name ?? "Unemployed")</p>
                </div>
            </div>
        </div>
    </div>
    <div class="hudItem">
        <p>💰</p>
        <div class="moneyDiv">
            <div class="moneyFill" style="width: 100%">
                <div class="moneyText">
                    <p>$@(_playerMoneyController.Money)</p>
                </div>
            </div>
        </div>
    </div>
</root>

@code
{
    [Property]
    private PlayerHealthController _playerHealthController;
    [Property]
    private PlayerJobController _playerJobController;
    [Property]
    private PlayerMoneyController _playerMoneyController;

    protected override int BuildHash()
        => System.HashCode.Combine(_playerHealthController.Health, _playerJobController.CurrentJob, _playerMoneyController.Money);
}
