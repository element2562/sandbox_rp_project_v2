@using Sandbox
@using Sandbox.UI
@using System
@inherits PanelComponent
@namespace Sandbox

@if (Network.IsProxy)
{
    return;
}

<root class="player-hud">
    <!-- Health Panel (Revised) -->
    <div class="health-panel">
        <div class="health-icon">❤️</div>
        <div class="text">
            <p class="label">Health</p>
            <p class="value">@(_playerHealthController.Health > 0 ? $"{_playerHealthController.Health}%" : "0%")</p>
        </div>
    </div>

    <!-- Job Panel -->
    <div class="job-panel">
        <div class="icon">💼</div>
        <div class="text">
            <p class="label">Job</p>
            <p class="value">@(_playerJobController.CurrentJob?.Name ?? "Unemployed")</p>
        </div>
    </div>

    <!-- Money Panel -->
    <div class="money-panel">
        <div class="icon">💰</div>
        <div class="text">
            <p class="label">Money</p>
            <p class="value">$@(_playerMoneyController.Money)</p>
        </div>
    </div>
</root>

@code
{
    [Property]
    private PlayerHealthController _playerHealthController;
    [Property]
    private PlayerJobController _playerJobController;
    [Property]
    private PlayerMoneyController _playerMoneyController;

    protected override int BuildHash()
        => System.HashCode.Combine(_playerHealthController.Health, _playerJobController.CurrentJob, _playerMoneyController.Money);
}
