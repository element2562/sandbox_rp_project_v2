@using Sandbox.UI
@inherits PanelComponent

<root>
    @if (Network.IsProxy) 
        return;
    <div class="crosshair @(_attackController.Hit ? "hit" : "")"></div>
</root>

@code {
    [Property] private PlayerAttackController _attackController;

    protected override int BuildHash() => System.HashCode.Combine(_attackController.Hit);
}
